---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, authors, paper } = post.data;
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description}>
	<article>
		<h1 class="post-title">{title}</h1>
		<dl class="post-meta">
			<div>
				<dt>Published</dt>
				<dd><time datetime={date.toISOString()}>{fmt.format(date)}</time></dd>
			</div>
			{authors.length > 0 && (
				<div>
					<dt>Authors</dt>
					<dd>{authors.join(', ')}</dd>
				</div>
			)}
			{paper && (
				<div>
					<dt>Paper</dt>
					<dd><a href={withBase(paper)}>PDF</a></dd>
				</div>
			)}
		</dl>
		<div class="prose">
			<Content />
		</div>
	</article>
</Base>
